#FLM: Install MW Script Manager
# Generated by tools/build_installer.py; edit manager/*.py instead.
import sys
import types

_MW_SOURCES = {'mwsm_core': '"""Standard-library-only, transactional package storage. No FontLab imports."""\nimport contextlib\nimport copy\nimport hashlib\nimport json\nimport os\nfrom pathlib import Path, PurePosixPath\nimport re\nimport shutil\nimport stat\nimport sys\nimport tempfile\nimport threading\nimport time\nimport unicodedata\nimport urllib.parse\nimport urllib.request\nimport uuid\n\nREPOSITORY = \'minw0525/Fontlab-python-scripts\'\nRAW = \'https://raw.githubusercontent.com/\' + REPOSITORY + \'/\'\nCATALOG_URL = RAW + \'main/manifest.json\'\nRUNTIME_VERSION = \'0.2.1\'\nHTTPS_FALLBACK = None\nMAX_FILE = 32 * 1024 * 1024\nMAX_PACKAGE = 100 * 1024 * 1024\nMARKER = \'# MW Script Manager owned wrapper v1\\n\'\n\n\nclass ManagerError(Exception):\n    pass\n\n\nclass Cancelled(ManagerError):\n    pass\n\n\ndef digest(data):\n    return hashlib.sha256(data).hexdigest()\n\n\ndef version_number(version):\n    if re.fullmatch(r\'(?:0|[1-9][0-9]*)[.](?:0|[1-9][0-9]*)[.](?:0|[1-9][0-9]*)\', version):\n        return tuple(map(int, version.split(\'.\')))\n    return None\n\n\ndef is_newer_version(candidate, installed):\n    new, old = version_number(candidate), version_number(installed)\n    return new is not None and old is not None and new > old\n\n\ndef token(value):\n    if not isinstance(value, str) or not re.fullmatch(r\'[A-Za-z0-9][A-Za-z0-9._-]{0,79}\', value):\n        raise ManagerError(\'잘못된 ID 또는 버전: %r\' % value)\n    relative(value)\n    return value\n\n\ndef relative(value):\n    if not isinstance(value, str) or not value or len(value) > 240:\n        raise ManagerError(\'잘못된 경로\')\n    parts = value.split(\'/\')\n    reserved = {\'CON\', \'PRN\', \'AUX\', \'NUL\'} | {x + str(i) for x in (\'COM\', \'LPT\') for i in range(1, 10)}\n    for part in parts:\n        if (part in (\'\', \'.\', \'..\') or part.endswith((\' \', \'.\')) or\n                any(c in part for c in \'\\\\:<>"|?*\') or any(ord(c) < 32 for c in part) or\n                part.split(\'.\')[0].upper() in reserved):\n            raise ManagerError(\'허용하지 않는 경로: \' + value)\n    return value\n\n\ndef path_key(value):\n    return unicodedata.normalize(\'NFC\', value).casefold()\n\n\ndef safe_path(root, value):\n    relative(value)\n    root = Path(root)\n    target = root.joinpath(*value.split(\'/\'))\n    # Walk all ancestors, including root: reject symlinks and Windows junctions.\n    for p in [target] + list(target.parents):\n        try:\n            info = p.lstat()\n        except FileNotFoundError:\n            continue\n        if stat.S_ISLNK(info.st_mode):\n            raise ManagerError(\'심볼릭 링크 경로는 사용할 수 없습니다: \' + str(p))\n        if getattr(info, \'st_file_attributes\', 0) & 0x400:\n            raise ManagerError(\'Windows reparse 경로는 사용할 수 없습니다: \' + str(p))\n    return target\n\n\ndef validate_package(p, manager=False):\n    if not isinstance(p, dict):\n        raise ManagerError(\'패키지 형식 오류\')\n    token(p.get(\'version\'))\n    if not re.fullmatch(\'[0-9a-f]{40}\', str(p.get(\'source_ref\', \'\'))):\n        raise ManagerError(\'source_ref는 40자리 고정 commit SHA여야 합니다\')\n    if not manager:\n        token(p.get(\'id\'))\n        if not isinstance(p.get(\'name\'), str) or not p[\'name\'].strip():\n            raise ManagerError(\'스크립트 이름이 없습니다\')\n        if not isinstance(p.get(\'requirements\', []), list) or not all(isinstance(x, str) for x in p.get(\'requirements\', [])):\n            raise ManagerError(\'requirements 형식 오류\')\n        if not isinstance(p.get(\'platforms\', []), list) or not set(p.get(\'platforms\', [])) <= {\'macos\', \'windows\'}:\n            raise ManagerError(\'platforms 형식 오류\')\n    files = p.get(\'files\')\n    if not isinstance(files, list) or not 0 < len(files) <= 500:\n        raise ManagerError(\'파일 목록이 없거나 너무 큽니다\')\n    targets = set()\n    for f in files:\n        if not isinstance(f, dict):\n            raise ManagerError(\'파일 메타데이터 오류\')\n        for key in (\'source\', \'target\'):\n            path = relative(f.get(key))\n            if PurePosixPath(path).suffix.lower() not in {\'.py\', \'.txt\', \'.json\', \'.csv\'} or \'__pycache__\' in path.split(\'/\') or \'.DS_Store\' in path.split(\'/\'):\n                raise ManagerError(\'배포할 수 없는 파일: \' + path)\n        expected_prefix = \'manager/\' if manager else \'FL8 Scripts/\'\n        if not f[\'source\'].startswith(expected_prefix):\n            raise ManagerError(\'소스 영역이 올바르지 않습니다\')\n        key = path_key(f[\'target\'])\n        if key in targets or any(key.startswith(t + \'/\') or t.startswith(key + \'/\') for t in targets):\n            raise ManagerError(\'중복되거나 충돌하는 파일 경로\')\n        targets.add(key)\n        if not re.fullmatch(\'[0-9a-f]{64}\', str(f.get(\'sha256\', \'\'))):\n            raise ManagerError(\'SHA-256 형식 오류\')\n    entry = p.get(\'entrypoint\', \'main.py\' if manager else \'\')\n    relative(entry)\n    if entry not in {f[\'target\'] for f in files} or not entry.endswith(\'.py\'):\n        raise ManagerError(\'진입 파일이 목록에 없습니다\')\n    if manager and not {\'main.py\', \'mwsm_core.py\', \'mwsm_host.py\', \'mwsm_ui.py\'} <= {f[\'target\'] for f in files}:\n        raise ManagerError(\'매니저 필수 파일이 없습니다\')\n    return p\n\n\ndef validate_manifest(m):\n    if not isinstance(m, dict) or m.get(\'schema_version\') != 1 or m.get(\'repository\') != REPOSITORY:\n        raise ManagerError(\'지원하지 않는 매니페스트 또는 저장소\')\n    validate_package(m.get(\'manager\'), True)\n    if not isinstance(m.get(\'scripts\'), list):\n        raise ManagerError(\'스크립트 목록 오류\')\n    ids = set()\n    for p in m[\'scripts\']:\n        validate_package(p)\n        key = path_key(p[\'id\'])\n        if key in ids:\n            raise ManagerError(\'중복 스크립트 ID\')\n        ids.add(key)\n    return m\n\n\ndef source_url(p, f):\n    return RAW + p[\'source_ref\'] + \'/\' + urllib.parse.quote(f[\'source\'], safe=\'/\')\n\n\ndef check_url(url):\n    u = urllib.parse.urlsplit(url)\n    if u.scheme != \'https\' or u.hostname not in {\'raw.githubusercontent.com\', \'github.com\'} or u.username or u.password or u.port not in (None, 443):\n        raise ManagerError(\'허용하지 않는 다운로드 URL\')\n\n\nclass SafeRedirect(urllib.request.HTTPRedirectHandler):\n    def redirect_request(self, req, fp, code, msg, headers, newurl):\n        check_url(newurl)\n        return super().redirect_request(req, fp, code, msg, headers, newurl)\n\n\nclass Downloader:\n    def __init__(self, cancel=None, progress=None):\n        self.cancel = cancel or threading.Event()\n        self.progress = progress or (lambda message: None)\n\n    def __call__(self, url, limit=MAX_FILE):\n        check_url(url)\n        self.check_cancel()\n        if not hasattr(urllib.request, \'HTTPSHandler\') and HTTPS_FALLBACK is not None:\n            return HTTPS_FALLBACK(url, limit, self.cancel, self.progress)\n        if not hasattr(urllib.request, \'HTTPSHandler\'):\n            raise ManagerError(\'FontLab 내장 Python의 SSL 기능을 사용할 수 없습니다. \'\n                               \'FontLab 설치/업데이트 상태를 확인하세요. 기존 설치는 유지됩니다.\')\n        start = time.monotonic()\n        request = urllib.request.Request(url, headers={\'User-Agent\': \'FL8-MW-Script-Manager/0.1\'})\n        chunks, size = [], 0\n        try:\n            with urllib.request.build_opener(SafeRedirect()).open(request, timeout=15) as response:\n                check_url(response.geturl())\n                if int(response.headers.get(\'Content-Length\', \'0\')) > limit:\n                    raise ManagerError(\'다운로드 크기 제한 초과\')\n                while True:\n                    self.check_cancel()\n                    if time.monotonic() - start > 120:\n                        raise ManagerError(\'다운로드 제한 시간 초과\')\n                    block = response.read(64 * 1024)\n                    if not block:\n                        break\n                    size += len(block)\n                    if size > limit:\n                        raise ManagerError(\'다운로드 크기 제한 초과\')\n                    chunks.append(block)\n                    self.progress(\'%s · %.1f MB\' % (urllib.parse.unquote(url.rsplit(\'/\', 1)[-1]), size / 1048576))\n        except ManagerError:\n            raise\n        except Exception as exc:\n            raise ManagerError(\'HTTPS 다운로드 실패 (네트워크/TLS/404/요청 제한 확인): \' + str(exc)) from exc\n        self.check_cancel()\n        return b\'\'.join(chunks)\n\n    def check_cancel(self):\n        if self.cancel.is_set():\n            raise Cancelled(\'작업을 취소했습니다\')\n\n\ndef json_bytes(data):\n    return (json.dumps(data, ensure_ascii=False, indent=2) + \'\\n\').encode(\'utf-8\')\n\n\ndef atomic_write(path, data):\n    path = Path(path)\n    safe_path(path.parent, path.name)\n    path.parent.mkdir(parents=True, exist_ok=True)\n    fd, name = tempfile.mkstemp(prefix=\'.mw-\', dir=str(path.parent))\n    try:\n        with os.fdopen(fd, \'wb\') as out:\n            out.write(data)\n            out.flush()\n            os.fsync(out.fileno())\n        os.replace(name, path)\n    finally:\n        if os.path.exists(name):\n            os.unlink(name)\n\n\ndef empty_state():\n    return {\'schema_version\': 1, \'manager\': None, \'packages\': {}, \'history\': {}}\n\n\ndef validate_state(s):\n    if not isinstance(s, dict) or s.get(\'schema_version\') != 1 or not isinstance(s.get(\'packages\'), dict) or not isinstance(s.get(\'history\'), dict):\n        raise ManagerError(\'state.json 형식 오류\')\n    records = [(True, s.get(\'manager\'))] + [(False, p) for p in s[\'packages\'].values()]\n    for manager, record in records:\n        if record is None and manager:\n            continue\n        if not isinstance(record, dict) or not isinstance(record.get(\'versions\'), dict):\n            raise ManagerError(\'설치 상태 레코드 오류\')\n        active = token(record.get(\'active_version\'))\n        if active not in record[\'versions\']:\n            raise ManagerError(\'활성 버전 기록 누락\')\n        for version, p in record[\'versions\'].items():\n            validate_package(p, manager)\n            if version != p[\'version\']:\n                raise ManagerError(\'버전 기록 불일치\')\n        previous = record.get(\'previous_version\')\n        if previous is not None and previous not in record[\'versions\']:\n            raise ManagerError(\'이전 버전 기록 누락\')\n        if not isinstance(record.get(\'auto_update\'), bool) or not isinstance(record.get(\'pinned\'), bool):\n            raise ManagerError(\'업데이트 설정 오류\')\n    for key, record in s[\'packages\'].items():\n        token(key)\n        if any(p[\'id\'] != key for p in record[\'versions\'].values()):\n            raise ManagerError(\'ID 기록 불일치\')\n    return s\n\n\ndef wrapper(package_id=None, header=None):\n    name = \'MW Script Manager\' if package_id is None else \'MW · \' + token(package_id)\n    header = header or \'#FLM: \' + name\n    if not header.startswith(\'#FLM:\') or any(ord(c) < 32 for c in header):\n        raise ManagerError(\'잘못된 메뉴 이름\')\n    return (header + \'\\n\' + MARKER +\n            \'from pathlib import Path\\nimport json, runpy\\nfrom fontlab import flPreferences\\n\'\n            \'_mw_root = Path(flPreferences.instance().dataPath) / "script_manager"\\n\'\n            \'_mw_state = json.loads((_mw_root / "state.json").read_text(encoding="utf-8"))\\n\'\n            \'_mw_version = _mw_state["manager"]["active_version"]\\n\'\n            \'if not isinstance(_mw_version, str) or not _mw_version or any(c not in "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789._-" for c in _mw_version) or _mw_version in (".", ".."):\\n\'\n            \'    raise RuntimeError("Invalid manager version")\\n\'\n            \'_mw_main = _mw_root / "manager" / _mw_version / "main.py"\\n\'\n            \'runpy.run_path(str(_mw_main), init_globals={"MW_PACKAGE_ID": \' + repr(package_id) + \'}, run_name="__main__")\\n\').encode(\'utf-8\')\n\n\nclass Store:\n    def __init__(self, user_data, downloader=None):\n        # The host-selected root may itself be redirected (macOS /var, OneDrive).\n        # Resolve that trusted root once; reject links anywhere inside our storage.\n        self.user_data = Path(user_data).expanduser().resolve()\n        if not self.user_data.is_dir():\n            raise ManagerError(\'FontLab 사용자 데이터 폴더가 없습니다\')\n        self.root = safe_path(self.user_data, \'script_manager\')\n        self.fetch = downloader or Downloader()\n        self.root.mkdir(exist_ok=True)\n        for name in (\'staging\', \'logs\'):\n            safe_path(self.root, name).mkdir(exist_ok=True)\n\n    def read_state(self):\n        path = safe_path(self.root, \'state.json\')\n        if not path.exists():\n            if safe_path(self.root, \'state.backup.json\').exists() or any((self.root / n).exists() for n in (\'packages\', \'manager\')):\n                raise ManagerError(\'state.json이 없습니다. 백업 복구를 사용하세요\')\n            return empty_state()\n        try:\n            return validate_state(json.loads(path.read_text(encoding=\'utf-8\')))\n        except Exception as exc:\n            raise ManagerError(\'state.json 손상: 백업 복구가 필요합니다. \' + str(exc)) from exc\n\n    def save_state(self, state):\n        validate_state(state)\n        path = safe_path(self.root, \'state.json\')\n        if path.exists():\n            previous = self.read_state()\n            atomic_write(safe_path(self.root, \'state.backup.json\'), json_bytes(previous))\n        atomic_write(path, json_bytes(state))\n\n    @contextlib.contextmanager\n    def locked(self):\n        path = safe_path(self.root, \'operation.lock\')\n        stream = path.open(\'a+b\')\n        try:\n            if sys.platform == \'win32\':\n                import msvcrt\n                stream.seek(0)\n                if not stream.read(1):\n                    stream.write(b\'0\')\n                    stream.flush()\n                stream.seek(0)\n                msvcrt.locking(stream.fileno(), msvcrt.LK_NBLCK, 1)\n            else:\n                import fcntl\n                fcntl.flock(stream.fileno(), fcntl.LOCK_EX | fcntl.LOCK_NB)\n        except OSError as exc:\n            stream.close()\n            raise ManagerError(\'다른 작업이 진행 중입니다\') from exc\n        try:\n            self.recover_transactions()\n            yield\n        finally:\n            stream.close()  # OS releases the lock, including after a crashed process.\n\n    def journal(self, stage, state, moves, created_wrapper=None, wrapper_content=None):\n        # Even a same-version repair needs a distinct commit marker.\n        state[\'transaction_id\'] = uuid.uuid4().hex\n        def local(path):\n            return path.relative_to(self.user_data).as_posix()\n        data = {\'state_sha256\': digest(json_bytes(state)),\n                \'moves\': [[local(a), local(b)] for a, b in moves],\n                \'wrapper\': local(created_wrapper) if created_wrapper else None,\n                \'wrapper_sha256\': digest(wrapper_content) if wrapper_content is not None else None,\n                \'wrapper_previous_sha256\': digest(created_wrapper.read_bytes()) if created_wrapper and created_wrapper.is_file() else None}\n        atomic_write(stage / \'transaction.json\', json_bytes(data))\n\n    def recover_transactions(self):\n        """Finish committed work or undo interrupted renames before accepting a writer."""\n        for stage in safe_path(self.root, \'staging\').iterdir():\n            safe_path(self.root, stage.relative_to(self.root).as_posix())\n            receipt = stage / \'transaction.json\'\n            if not receipt.exists():\n                # An interrupted download has not touched active files.\n                if stage.is_dir() and stage.name.startswith((\'install-\', \'remove-\', \'wrapper-\')):\n                    shutil.rmtree(stage)\n                continue\n            receipt = safe_path(stage, \'transaction.json\')\n            data = json.loads(receipt.read_text(encoding=\'utf-8\'))\n            current = safe_path(self.root, \'state.json\')\n            committed = current.exists() and digest(current.read_bytes()) == data[\'state_sha256\']\n            if not committed:\n                name = data.get(\'wrapper\')\n                if name:\n                    path = safe_path(self.user_data, name)\n                    package_id = None if name == \'Scripts/MW Script Manager.py\' else path.stem\n                    if name != \'Scripts/MW Script Manager.py\' and not name.startswith(\'Scripts/MW Scripts/\'):\n                        raise ManagerError(\'복구 래퍼 경로 오류\')\n                    if path.exists():\n                        actual = digest(path.read_bytes())\n                        moved = any(source == name and safe_path(self.user_data, dest).exists() for source, dest in data[\'moves\'])\n                        if actual == data.get(\'wrapper_previous_sha256\') and not moved:\n                            pass  # Crash before the original wrapper was moved aside.\n                        elif actual == (data.get(\'wrapper_sha256\') or digest(wrapper(package_id))):\n                            path.unlink()\n                        else:\n                            raise ManagerError(\'복구 대상 래퍼가 수정되었습니다\')\n                for source, dest in reversed(data[\'moves\']):\n                    # Journals may only rename managed storage or a generated wrapper.\n                    for name in (source, dest):\n                        if not name.startswith((\'script_manager/staging/\', \'script_manager/packages/\', \'script_manager/manager/\', \'Scripts/MW Scripts/\')):\n                            raise ManagerError(\'복구 기록의 경로가 올바르지 않습니다\')\n                    source, dest = safe_path(self.user_data, source), safe_path(self.user_data, dest)\n                    if not source.exists() and dest.exists():\n                        source.parent.mkdir(parents=True, exist_ok=True)\n                        os.replace(dest, source)\n            shutil.rmtree(stage)\n            self.log(\'recovered interrupted transaction \' + stage.name)\n\n    def log(self, message):\n        try:\n            path = safe_path(self.root, \'logs/install.log\')\n            if path.exists() and path.stat().st_size > 1024 * 1024:\n                os.replace(path, safe_path(self.root, \'logs/install.previous.log\'))\n            with path.open(\'a\', encoding=\'utf-8\') as out:\n                out.write(time.strftime(\'%Y-%m-%d %H:%M:%S \') + message + \'\\n\')\n        except (OSError, ManagerError):\n            pass  # A completed transaction must not become an error because logging failed.\n\n    def catalog(self, manual=True):\n        path = safe_path(self.root, \'manifest-cache.json\')\n        cached = None\n        if path.exists():\n            try:\n                cached = json.loads(path.read_text(encoding=\'utf-8\'))\n                validate_manifest(cached[\'manifest\'])\n            except (ValueError, KeyError, TypeError, ManagerError):\n                cached = None\n        if not manual and cached and 0 <= time.time() - cached[\'checked_at\'] < 86400:\n            return cached[\'manifest\'], None\n        try:\n            m = validate_manifest(json.loads(self.fetch(CATALOG_URL, 2 * 1024 * 1024)))\n            atomic_write(path, json_bytes({\'checked_at\': time.time(), \'manifest\': m}))\n            return m, None\n        except Cancelled:\n            raise\n        except Exception as exc:\n            if cached:\n                return cached[\'manifest\'], \'오프라인/카탈로그 오류 · 캐시 표시: \' + str(exc)\n            raise ManagerError(\'카탈로그를 읽지 못했습니다: \' + str(exc)) from exc\n\n    def version_dir(self, p, manager=False):\n        prefix = \'manager\' if manager else \'packages/\' + token(p[\'id\'])\n        return safe_path(self.root, prefix + \'/\' + token(p[\'version\']))\n\n    def wrapper_path(self, package_id=None):\n        if package_id is None:\n            return safe_path(self.user_data, \'Scripts/MW Script Manager.py\')\n        record = self.read_state()[\'packages\'].get(package_id, {})\n        filename = record.get(\'wrapper\', {}).get(\'filename\', token(package_id) + \'.py\')\n        return self.named_wrapper_path(filename)\n\n    def named_wrapper_path(self, filename):\n        relative(filename)\n        if \'/\' in filename or not filename.endswith(\'.py\'):\n            raise ManagerError(\'잘못된 실행 파일명\')\n        return safe_path(self.user_data, \'Scripts/MW Scripts/\' + filename)\n\n    def wrapper_metadata(self, p, entry):\n        filename = PurePosixPath(p[\'entrypoint\']).name\n        header = next((line for line in entry.decode(\'utf-8-sig\').splitlines()\n                       if line.startswith(\'#FLM:\')), \'#FLM: \' + p[\'name\'])\n        wrapper(p[\'id\'], header)  # Validate a single-line menu label.\n        return {\'filename\': filename, \'header\': header, \'source_version\': p[\'version\']}\n\n    def migrate_wrappers(self):\n        """Restore source names without downloading or changing package versions."""\n        changed = []\n        with self.locked():\n            state = self.read_state()\n            for key, record in state[\'packages\'].items():\n                if record.get(\'wrapper\', {}).get(\'source_version\') == record[\'active_version\']:\n                    continue\n                p = record[\'versions\'][record[\'active_version\']]\n                self.verify(p)\n                meta = self.wrapper_metadata(p, safe_path(self.version_dir(p), p[\'entrypoint\']).read_bytes())\n                if record.get(\'wrapper\') == meta:\n                    continue\n                old = self.check_wrapper(key, allow_missing=True)\n                target = self.named_wrapper_path(meta[\'filename\'])\n                if target != old and target.exists():\n                    raise ManagerError(\'기존 파일과 충돌합니다: \' + str(target))\n                for other, other_record in state[\'packages\'].items():\n                    if other != key and path_key(other_record.get(\'wrapper\', {}).get(\'filename\', other + \'.py\')) == path_key(meta[\'filename\']):\n                        raise ManagerError(\'다른 패키지가 사용 중인 파일명: \' + meta[\'filename\'])\n                content = wrapper(key, meta[\'header\'])\n                stage = Path(tempfile.mkdtemp(prefix=\'wrapper-\', dir=str(self.root / \'staging\')))\n                saved = stage / \'old.py\'\n                new_state = copy.deepcopy(state)\n                new_state[\'packages\'][key][\'wrapper\'] = meta\n                self.journal(stage, new_state, [(old, saved)] if old.exists() else [], target, content)\n                committed = created = False\n                try:\n                    if old.exists():\n                        os.replace(old, saved)\n                    atomic_write(target, content)\n                    created = True\n                    self.save_state(new_state)\n                    committed = True\n                    state = new_state\n                    changed.append(key)\n                finally:\n                    if not committed:\n                        if created:\n                            target.unlink()\n                        if saved.exists():\n                            os.replace(saved, old)\n                    shutil.rmtree(stage, ignore_errors=True)\n            return changed\n\n    def verify(self, p, manager=False):\n        base = self.version_dir(p, manager)\n        expected = {f[\'target\']: f[\'sha256\'] for f in p[\'files\']}\n        if not base.is_dir():\n            raise ManagerError(\'설치 파일이 없습니다: \' + str(base))\n        for f in p[\'files\']:\n            target = safe_path(base, f[\'target\'])\n            if not target.is_file() or digest(target.read_bytes()) != f[\'sha256\']:\n                raise ManagerError(\'로컬 수정 또는 손상: \' + str(target))\n        for path in base.rglob(\'*\'):\n            safe_path(base, path.relative_to(base).as_posix())\n            if path.is_file() and path.relative_to(base).as_posix() not in expected:\n                raise ManagerError(\'등록되지 않은 파일이 있습니다: \' + str(path))\n\n    def check_wrapper(self, package_id, allow_missing=False):\n        path = self.wrapper_path(package_id)\n        record = self.read_state()[\'packages\'].get(package_id, {}) if package_id else {}\n        content = wrapper(package_id, record.get(\'wrapper\', {}).get(\'header\'))\n        if path.exists():\n            if not path.is_file() or path.read_bytes() != content:\n                raise ManagerError(\'기존 파일과 충돌합니다 (자동 덮어쓰기 금지): \' + str(path))\n        elif not allow_missing:\n            raise ManagerError(\'실행 래퍼가 없습니다: \' + str(path))\n        return path\n\n    def install(self, p, manager=False, repair=False):\n        validate_package(p, manager)\n        package_id = None if manager else p[\'id\']\n        with self.locked():\n            state = self.read_state()\n            if not (self.root / \'state.json\').exists():\n                self.save_state(state)\n            record = state[\'manager\'] if manager else state[\'packages\'].get(package_id)\n            if record and p[\'version\'] != record[\'active_version\'] and not is_newer_version(p[\'version\'], record[\'active_version\']):\n                raise ManagerError(\'설치 버전보다 높은 버전만 업데이트할 수 있습니다.\')\n            key = (\'manager\' if manager else \'packages/\' + package_id) + \'/\' + p[\'version\']\n            fingerprint = digest(json_bytes(sorted(p[\'files\'], key=lambda f: f[\'target\'])))\n            if key in state[\'history\'] and state[\'history\'][key] != fingerprint:\n                raise ManagerError(\'같은 ID/버전의 파일 해시가 바뀐 배포입니다: \' + key)\n            if record and not (manager and repair):\n                self.verify(record[\'versions\'][record[\'active_version\']], manager)\n            target_wrapper = self.check_wrapper(package_id, allow_missing=True)\n            if record is None and target_wrapper.exists():\n                raise ManagerError(\'소유 기록 없는 동명 실행 파일: \' + str(target_wrapper))\n            old_wrapper = target_wrapper\n            if not manager:\n                target_wrapper = self.named_wrapper_path(PurePosixPath(p[\'entrypoint\']).name)\n                if target_wrapper != old_wrapper and target_wrapper.exists():\n                    raise ManagerError(\'기존 파일과 충돌합니다: \' + str(target_wrapper))\n                for other, other_record in state[\'packages\'].items():\n                    if other != package_id and path_key(other_record.get(\'wrapper\', {}).get(\'filename\', other + \'.py\')) == path_key(target_wrapper.name):\n                        raise ManagerError(\'다른 패키지가 사용 중인 파일명: \' + target_wrapper.name)\n            dest = self.version_dir(p, manager)\n            if dest.exists() and (not record or p[\'version\'] not in record[\'versions\']):\n                raise ManagerError(\'소유 기록 없는 버전 폴더: \' + str(dest))\n            stage = Path(tempfile.mkdtemp(prefix=\'install-\', dir=str(self.root / \'staging\')))\n            displaced = None\n            wrapper_backup = None\n            created_dest = created_wrapper = committed = False\n            try:\n                payload = stage / \'payload\'\n                payload.mkdir()\n                size = 0\n                for f in p[\'files\']:\n                    data = self.fetch(source_url(p, f), MAX_FILE)\n                    size += len(data)\n                    if size > MAX_PACKAGE or len(data) > MAX_FILE:\n                        raise ManagerError(\'패키지 크기 제한 초과\')\n                    if digest(data) != f[\'sha256\']:\n                        raise ManagerError(\'SHA-256 불일치: \' + f[\'source\'])\n                    out = safe_path(payload, f[\'target\'])\n                    out.parent.mkdir(parents=True, exist_ok=True)\n                    out.write_bytes(data)\n                if hasattr(self.fetch, \'check_cancel\'):\n                    self.fetch.check_cancel()\n                new = copy.deepcopy(record) if record else {\'versions\': {}, \'auto_update\': True, \'pinned\': False}\n                old = new.get(\'active_version\')\n                if old != p[\'version\']:\n                    new[\'previous_version\'] = old\n                new[\'active_version\'] = p[\'version\']\n                new[\'versions\'][p[\'version\']] = copy.deepcopy(p)\n                meta = None if manager else self.wrapper_metadata(p, safe_path(payload, p[\'entrypoint\']).read_bytes())\n                content = wrapper(package_id, meta[\'header\'] if meta else None)\n                if meta:\n                    new[\'wrapper\'] = meta\n                state[\'history\'][key] = fingerprint\n                if manager:\n                    state[\'manager\'] = new\n                else:\n                    state[\'packages\'][package_id] = new\n                moves = []\n                if dest.exists() and manager and repair:\n                    moves.append((dest, stage / \'previous\'))\n                if not dest.exists() or (manager and repair):\n                    moves.append((payload, dest))\n                replace_wrapper = not old_wrapper.exists() or old_wrapper != target_wrapper or old_wrapper.read_bytes() != content\n                if replace_wrapper and old_wrapper.exists():\n                    moves.append((old_wrapper, stage / \'wrapper.py\'))\n                self.journal(stage, state, moves, target_wrapper if replace_wrapper else None, content)\n                dest.parent.mkdir(parents=True, exist_ok=True)\n                if dest.exists():\n                    if manager and repair:\n                        displaced = stage / \'previous\'\n                        os.replace(dest, displaced)\n                    else:\n                        self.verify(p, manager)\n                if not dest.exists():\n                    os.replace(payload, dest)\n                    created_dest = True\n                if replace_wrapper:\n                    if old_wrapper.exists():\n                        wrapper_backup = stage / \'wrapper.py\'\n                        os.replace(old_wrapper, wrapper_backup)\n                    atomic_write(target_wrapper, content)\n                    created_wrapper = True\n                self.save_state(state)\n                committed = True\n                self.log(\'install \' + key)\n            finally:\n                if not committed:\n                    if created_wrapper:\n                        target_wrapper.unlink()\n                    if wrapper_backup is not None and wrapper_backup.exists():\n                        os.replace(wrapper_backup, old_wrapper)\n                    if created_dest:\n                        shutil.rmtree(dest)\n                    if displaced is not None and displaced.exists():\n                        os.replace(displaced, dest)\n                shutil.rmtree(stage, ignore_errors=True)\n\n    def settings(self, package_id, auto_update, pinned):\n        with self.locked():\n            state = self.read_state()\n            record = state[\'packages\'][package_id]\n            record.update(auto_update=bool(auto_update), pinned=bool(pinned))\n            self.save_state(state)\n\n    def updates(self, catalog, automatic=False):\n        state = self.read_state()\n        return [p for p in catalog[\'scripts\'] if p[\'id\'] in state[\'packages\']\n                and is_newer_version(p[\'version\'], state[\'packages\'][p[\'id\']][\'active_version\'])\n                and not state[\'packages\'][p[\'id\']][\'pinned\']\n                and (not automatic or state[\'packages\'][p[\'id\']][\'auto_update\'])]\n\n    def rollback(self, package_id):\n        with self.locked():\n            state = self.read_state()\n            record = state[\'packages\'][package_id]\n            previous = record.get(\'previous_version\')\n            if not previous:\n                raise ManagerError(\'이전 버전이 없습니다\')\n            self.check_wrapper(package_id)\n            self.verify(record[\'versions\'][previous])\n            record[\'previous_version\'], record[\'active_version\'] = record[\'active_version\'], previous\n            record[\'auto_update\'] = False\n            self.save_state(state)\n            self.log(\'rollback \' + package_id + \'/\' + previous)\n        self.migrate_wrappers()\n\n    def remove(self, package_id):\n        with self.locked():\n            state = self.read_state()\n            record = state[\'packages\'][package_id]\n            target_wrapper = self.check_wrapper(package_id, allow_missing=True)\n            for p in record[\'versions\'].values():\n                self.verify(p)\n            base = safe_path(self.root, \'packages/\' + token(package_id))\n            if {p.name for p in base.iterdir()} != set(record[\'versions\']):\n                raise ManagerError(\'패키지 폴더에 소유하지 않은 데이터가 있습니다\')\n            stage = Path(tempfile.mkdtemp(prefix=\'remove-\', dir=str(self.root / \'staging\')))\n            moved = []\n            committed = False\n            try:\n                del state[\'packages\'][package_id]\n                self.journal(stage, state, [(source, stage / name) for source, name in\n                             ((target_wrapper, \'wrapper.py\'), (base, \'package\')) if source.exists()])\n                for source, name in ((target_wrapper, \'wrapper.py\'), (base, \'package\')):\n                    if source.exists():\n                        dest = stage / name\n                        os.replace(source, dest)\n                        moved.append((source, dest))\n                self.save_state(state)\n                committed = True\n                self.log(\'remove \' + package_id)\n            finally:\n                if not committed:\n                    for source, dest in reversed(moved):\n                        os.replace(dest, source)\n                shutil.rmtree(stage, ignore_errors=True)\n\n    def recover(self):\n        with self.locked():\n            backup = safe_path(self.root, \'state.backup.json\')\n            state = validate_state(json.loads(backup.read_text(encoding=\'utf-8\')))\n            for manager, record in [(True, state[\'manager\'])] + [(False, r) for r in state[\'packages\'].values()]:\n                if record:\n                    self.verify(record[\'versions\'][record[\'active_version\']], manager)\n            current = safe_path(self.root, \'state.json\')\n            if current.exists():\n                atomic_write(safe_path(self.root, \'state.damaged-%d.json\' % time.time_ns()), current.read_bytes())\n            atomic_write(current, json_bytes(state))\n            self.log(\'state restored from verified backup\')\n', 'mwsm_host': '"""FontLab UI-thread integration and explicit script execution."""\nimport importlib.util\nfrom pathlib import Path\nimport platform\nimport runpy\nimport sys\n\nfrom mwsm_core import ManagerError, Store, safe_path\n\n\ndef environment():\n    import fontlab\n    from PythonQt import QtCore, QtGui\n    try:\n        value = fontlab.flPreferences.instance().dataPath\n    except Exception as exc:\n        raise ManagerError(\'사용자 데이터 경로 API를 사용할 수 없습니다: \' + str(exc)) from exc\n    if not value or not Path(str(value)).expanduser().is_dir():\n        raise ManagerError(\'FontLab 사용자 데이터 경로가 유효하지 않습니다\')\n    for name in (\'QDialog\', \'QTableWidget\', \'QProgressBar\'):\n        if not hasattr(QtGui, name):\n            raise ManagerError(\'필수 PythonQt 기능 없음: \' + name)\n    return {\'user_data\': str(Path(str(value)).expanduser()), \'python\': sys.version,\n            \'platform\': platform.platform(), \'qt\': QtCore.qVersion(),\n            \'fontlab\': str(getattr(fontlab, \'__version__\', \'버전 API 미제공\'))}\n\n\ndef refresh_scripts():\n    try:\n        from fontlab import flWorkspace\n        main = flWorkspace.instance().mainWindow\n        if main is not None:\n            for obj in main.children():\n                tip = getattr(obj, \'statusTip\', \'\')\n                if callable(tip):\n                    tip = tip()\n                if tip == \'@mainwindow.actionRefreshScripts\':\n                    obj.trigger()\n                    return True\n    except Exception:\n        pass\n    return False\n\n\ndef compatibility(p):\n    current = {\'darwin\': \'macos\', \'win32\': \'windows\'}.get(sys.platform, sys.platform)\n    if p.get(\'platforms\') and current not in p[\'platforms\']:\n        return \'지원하지 않는 OS: \' + current\n    missing = []\n    for requirement in p.get(\'requirements\', []):\n        module = \'typerig\' if requirement == \'TypeRig\' else requirement\n        try:\n            if importlib.util.find_spec(module) is None:\n                missing.append(requirement)\n        except (ImportError, ValueError, AttributeError):\n            missing.append(requirement)\n    return \'필요 라이브러리: \' + \', \'.join(missing) if missing else None\n\n\n# Retain GUI globals, and refuse to hot-reload modules still referenced by Qt objects.\n_sessions = {}\n\n\ndef run_package(user_data, package_id):\n    store = Store(user_data)\n    with store.locked():\n        pass\n    state = store.read_state()\n    record = state[\'packages\'].get(package_id)\n    if record is None:\n        raise ManagerError(\'설치되지 않은 스크립트입니다\')\n    p = record[\'versions\'][record[\'active_version\']]\n    reason = compatibility(p)\n    if reason:\n        raise ManagerError(reason)\n    store.verify(p)\n    base = store.version_dir(p)\n    parent = base.parent.resolve()\n    for module in list(sys.modules.values()):\n        location = getattr(module, \'__file__\', None)\n        if location:\n            location = Path(location).resolve()\n            if parent in location.parents and base.resolve() not in location.parents:\n                raise ManagerError(\'이 패키지의 이전 모듈이 사용 중입니다. FontLab을 재시작하세요\')\n    prior = _sessions.get(package_id)\n    if prior and prior[0] != p[\'version\']:\n        raise ManagerError(\'업데이트된 스크립트를 실행하려면 FontLab을 재시작하세요\')\n    # Avoid collisions with unrelated packages using the same top-level module name.\n    local_names = {f[\'target\'].split(\'/\')[0].removesuffix(\'.py\') for f in p[\'files\']}\n    for name in local_names:\n        module = sys.modules.get(name)\n        if module is not None:\n            location = getattr(module, \'__file__\', None)\n            if not location or base.resolve() not in Path(location).resolve().parents:\n                raise ManagerError(\'이미 로드된 다른 모듈과 충돌합니다: \' + name)\n    original = sys.path[:]\n    old_bytecode = sys.dont_write_bytecode\n    try:\n        sys.dont_write_bytecode = True\n        sys.path.insert(0, str(base))\n        result = runpy.run_path(str(safe_path(base, p[\'entrypoint\'])), run_name=\'__main__\')\n        _sessions[package_id] = (p[\'version\'], result)\n        return result\n    finally:\n        sys.path[:] = original\n        sys.dont_write_bytecode = old_bytecode\n\n\nclass QtHttpsBridge:\n    """Main-thread Qt network I/O serving the existing Python worker via a queue."""\n    def __init__(self):\n        import queue\n        import threading\n        self.owner_thread = threading.get_ident()\n        from PythonQt import QtCore, QtNetwork\n        self.qt = QtCore\n        self.network = QtNetwork\n        self.pending = queue.Queue()\n        self.active = []\n        self.manager = QtNetwork.QNetworkAccessManager()\n        self.timer = QtCore.QTimer(self.manager)\n        self.timer.connect(\'timeout()\', self.poll)\n        self.timer.start(50)\n\n    def __call__(self, url, limit, cancel, progress):\n        import threading\n        import time\n        from mwsm_core import check_url, Cancelled\n        if threading.get_ident() == self.owner_thread:\n            raise ManagerError(\'HTTPS 요청은 작업자 스레드에서 실행해야 합니다\')\n        deadline = time.monotonic() + 120\n        for _ in range(6):\n            check_url(url)\n            job = {\'url\': url, \'limit\': limit, \'cancel\': cancel, \'progress\': progress,\n                   \'deadline\': deadline, \'done\': threading.Event(), \'data\': bytearray(), \'error\': None}\n            self.pending.put(job)\n            while not job[\'done\'].wait(0.1):\n                if cancel.is_set():\n                    raise Cancelled(\'작업을 취소했습니다\')\n                if time.monotonic() >= deadline:\n                    raise ManagerError(\'다운로드 제한 시간 초과\')\n            if job[\'error\']:\n                raise job[\'error\']\n            if cancel.is_set():\n                raise Cancelled(\'작업을 취소했습니다\')\n            if job.get(\'redirect\'):\n                url = job[\'redirect\']\n                continue\n            return bytes(job[\'data\'])\n        raise ManagerError(\'리디렉션 횟수 제한 초과\')\n\n    def poll(self):\n        import queue\n        import time\n        from mwsm_core import Cancelled\n        while True:\n            try:\n                job = self.pending.get_nowait()\n            except queue.Empty:\n                break\n            try:\n                request = self.network.QNetworkRequest(self.qt.QUrl(job[\'url\']))\n                # FontLab\'s PythonQt exposes the Qt 5 legacy attribute.\n                request.setAttribute(self.network.QNetworkRequest.FollowRedirectsAttribute, False)\n                reply = self.manager.get(request)\n                reply.setReadBufferSize(64 * 1024)\n                job[\'reply\'] = reply\n                self.active.append(job)\n                reply.connect(\'readyRead()\', lambda j=job: self.read(j))\n                reply.connect(\'finished()\', lambda j=job: self.finish(j))\n            except Exception as exc:\n                job[\'error\'] = ManagerError(\'Qt HTTPS 시작 실패: \' + str(exc))\n                job[\'done\'].set()\n        for job in list(self.active):\n            if job[\'cancel\'].is_set() or time.monotonic() >= job[\'deadline\']:\n                job[\'error\'] = Cancelled(\'작업을 취소했습니다\') if job[\'cancel\'].is_set() else ManagerError(\'다운로드 제한 시간 초과\')\n                job[\'reply\'].abort()\n\n    def read(self, job):\n        try:\n            data = job[\'reply\'].readAll().data()\n            if len(job[\'data\']) + len(data) > job[\'limit\']:\n                raise ManagerError(\'다운로드 크기 제한 초과\')\n            job[\'data\'].extend(data)\n            job[\'progress\'](\'HTTPS 다운로드 · %.1f MB\' % (len(job[\'data\']) / 1048576))\n        except Exception as exc:\n            job[\'error\'] = ManagerError(str(exc))\n            job[\'reply\'].abort()\n\n    def finish(self, job):\n        from mwsm_core import check_url\n        reply = job[\'reply\']\n        try:\n            if not job[\'error\']:\n                self.read(job)\n            if not job[\'error\']:\n                status = reply.attribute(self.network.QNetworkRequest.HttpStatusCodeAttribute)\n                if reply.error() != self.network.QNetworkReply.NoError:\n                    raise ManagerError(\'HTTPS 다운로드 실패: \' + reply.errorString())\n                if status in (301, 302, 303, 307, 308):\n                    target = reply.attribute(self.network.QNetworkRequest.RedirectionTargetAttribute)\n                    redirect = reply.url().resolved(target).toString()\n                    check_url(redirect)\n                    job[\'redirect\'] = redirect\n                elif status != 200:\n                    raise ManagerError(\'HTTPS 응답 오류: \' + str(status))\n        except Exception as exc:\n            job[\'error\'] = ManagerError(str(exc))\n        finally:\n            if job in self.active:\n                self.active.remove(job)\n            reply.deleteLater()\n            job[\'done\'].set()\n\n\n_https_bridge = None\n\n\ndef prepare_https():\n    """Use only the Qt runtime already shipped by FontLab; never relax TLS checks."""\n    import urllib.request\n    import mwsm_core\n    global _https_bridge\n    if hasattr(urllib.request, \'HTTPSHandler\'):\n        return\n    from PythonQt import QtNetwork\n    if not QtNetwork.QSslSocket.supportsSsl():\n        raise ManagerError(\'Python과 FontLab 내장 Qt 모두 HTTPS를 지원하지 않습니다\')\n    if _https_bridge is None:\n        _https_bridge = QtHttpsBridge()\n    mwsm_core.HTTPS_FALLBACK = _https_bridge\n', 'mwsm_ui': '"""Quiet, list-based PythonQt UI. File/network work stays in the worker."""\nimport queue\nimport threading\nfrom PythonQt import QtCore, QtGui\n\nfrom mwsm_core import Cancelled, Downloader, ManagerError, Store, REPOSITORY, RUNTIME_VERSION, is_newer_version\nfrom mwsm_host import compatibility, refresh_scripts, prepare_https\n\n_windows = []\n\nSTYLE = \'\'\'\nQDialog, QScrollArea, QWidget#list { background: #fafafa; color: #171717; }\nQLabel { color: #171717; background: transparent; font-size: 13px; }\nQLabel#title { font-size: 24px; font-weight: 600; }\nQLabel#muted { color: #727272; font-size: 12px; }\nQLabel#rowStatus { color: #626262; font-size: 12px; }\nQWidget#row { border-bottom: 1px solid #e9e9e9; background: transparent; }\nQPushButton { color: #444; background: transparent; border: 1px solid transparent;\n              border-radius: 7px; padding: 7px 12px; font-size: 13px; }\nQPushButton:hover { background: #eeeeee; color: #111; }\nQPushButton:focus { border: 1px solid #8b8b8b; }\nQPushButton:disabled { color: #aaa; }\nQPushButton#filter:checked { background: #eaeaea; color: #111; font-weight: 600; }\nQPushButton#name { text-align: left; font-size: 17px; font-weight: 400; padding: 0px; border-radius: 3px; }\nQPushButton#name:hover { background: transparent; color: #555; }\nQPushButton#pick { padding: 0px; border: 1px solid #c9c9c9; border-radius: 11px; font-size: 15px; }\nQPushButton#pick:checked { background: #171717; border-color: #171717; color: white; }\nQPushButton#pick:disabled { border-color: #e2e2e2; background: #f3f3f3; }\nQPushButton#primary { background: #171717; color: #fff; border-radius: 10px; padding: 12px; font-weight: 600; }\nQPushButton#primary:hover { background: #333; }\nQPushButton#primary:disabled { background: #e8e8e8; color: #929292; }\nQPushButton#danger { color: #a63434; }\nQScrollArea { border: none; }\nQProgressBar { border: none; background: #e8e8e8; border-radius: 2px; }\nQProgressBar::chunk { background: #333; border-radius: 2px; }\nQCheckBox { color: #333; spacing: 8px; font-size: 13px; }\n\'\'\'\n\n\ndef value(obj, name):\n    result = getattr(obj, name)\n    return result() if callable(result) else result\n\n\ndef label(text, name=None):\n    widget = QtGui.QLabel(text)\n    widget.setTextFormat(QtCore.Qt.PlainText)\n    if name:\n        widget.setObjectName(name)\n    return widget\n\n\ndef button(text, callback, name=None):\n    widget = QtGui.QPushButton(text)\n    widget.setAutoDefault(False)\n    if name:\n        widget.setObjectName(name)\n    widget.connect(\'clicked()\', callback)\n    return widget\n\n\nclass ManagerWindow:\n    def __init__(self, env, bootstrap=False):\n        prepare_https()\n        self.env, self.bootstrap = env, bootstrap\n        self.events = queue.Queue()\n        self.cancel = threading.Event()\n        self.store = Store(env[\'user_data\'])\n        self.manifest = None\n        self.offline = None\n        self.busy = False\n        self.rows = []\n        self.errors = {}\n        self.checked = set()\n        self.filter = \'all\'\n        self.detail_dialog = None\n        self.dialog = QtGui.QDialog()\n        self.dialog.setWindowTitle(\'MW Script Manager\')\n        self.dialog.setStyleSheet(STYLE)\n        self.dialog.resize(760, 700)\n        self.dialog.setMinimumSize(620, 480)\n        layout = QtGui.QVBoxLayout(self.dialog)\n        layout.setContentsMargins(28, 24, 28, 20)\n        layout.setSpacing(16)\n        header = QtGui.QHBoxLayout()\n        header.addWidget(label(\'MW Script Manager\', \'title\'))\n        header.addStretch()\n        self.options = button(\'설정\', self.show_settings)\n        header.addWidget(self.options)\n        layout.addLayout(header)\n        toolbar = QtGui.QHBoxLayout()\n        toolbar.setSpacing(4)\n        self.filters = {}\n        for key, title in ((\'all\', \'전체\'), (\'installed\', \'설치됨\'), (\'updates\', \'업데이트\')):\n            control = button(title, lambda k=key: self.set_filter(k), \'filter\')\n            control.setCheckable(True)\n            control.setChecked(key == self.filter)\n            self.filters[key] = control\n            toolbar.addWidget(control)\n        self.select_all = button(\'모두 선택\', self.select_updates)\n        self.select_all.hide()\n        toolbar.addWidget(self.select_all)\n        toolbar.addStretch()\n        self.reload = button(\'새로고침\', self.refresh)\n        toolbar.addWidget(self.reload)\n        layout.addLayout(toolbar)\n        self.scroll = QtGui.QScrollArea()\n        self.scroll.setWidgetResizable(True)\n        self.scroll.setHorizontalScrollBarPolicy(QtCore.Qt.ScrollBarAlwaysOff)\n        layout.addWidget(self.scroll, 1)\n        self.list_content = None\n        self.primary = button(\'선택 설치\', self.install_selected, \'primary\')\n        self.primary.setMinimumHeight(46)\n        self.primary.setEnabled(False)\n        layout.addWidget(self.primary)\n        footer = QtGui.QHBoxLayout()\n        self.status = label(\'목록을 확인하고 있습니다.\', \'muted\')\n        self.status.setWordWrap(True)\n        self.status.setMinimumHeight(32)\n        footer.addWidget(self.status, 1)\n        self.stop = button(\'취소\', self.cancel.set)\n        self.stop.hide()\n        footer.addWidget(self.stop)\n        layout.addLayout(footer)\n        self.progress = QtGui.QProgressBar()\n        self.progress.setFixedHeight(3)\n        self.progress.setTextVisible(False)\n        self.progress.hide()\n        layout.addWidget(self.progress)\n        self.controls = [self.options, self.reload, self.select_all] + list(self.filters.values())\n        self.timer = QtCore.QTimer(self.dialog)\n        self.timer.connect(\'timeout()\', self.poll)\n        self.timer.start(100)\n        self.render()\n        self.dialog.show()\n        self.refresh()\n\n    def set_filter(self, key):\n        self.filter = key\n        self.select_all.setVisible(key == \'updates\')\n        self.checked.clear()\n        for name, control in self.filters.items():\n            control.setChecked(name == key)\n        self.render()\n\n    def select_updates(self):\n        state = self.store.read_state()\n        self.checked = {p[\'id\'] for p in self.rows if p[\'id\'] in state[\'packages\']\n                        and is_newer_version(p[\'version\'], state[\'packages\'][p[\'id\']][\'active_version\'])\n                        and not state[\'packages\'][p[\'id\']][\'pinned\'] and not compatibility(p)}\n        self.render()\n\n    def start(self, job, done=None):\n        if self.busy:\n            return\n        self.busy = True\n        self.cancel.clear()\n        self.store.fetch = Downloader(self.cancel, lambda msg: self.events.put((\'progress\', msg)))\n        self.progress.setRange(0, 0)\n        self.progress.show()\n        self.stop.show()\n        self.primary.setEnabled(False)\n        for control in self.controls:\n            control.setEnabled(False)\n        if self.list_content:\n            self.list_content.setEnabled(False)\n        def worker():\n            try:\n                with self.store.locked():\n                    pass\n                self.events.put((\'done\', (job(), done)))\n            except Exception as exc:\n                self.store.log(\'error \' + str(exc))\n                self.events.put((\'error\', str(exc)))\n        threading.Thread(target=worker, name=\'MW Script Manager\', daemon=True).start()\n\n    def poll(self):\n        latest = None\n        for _ in range(100):\n            try:\n                kind, payload = self.events.get_nowait()\n            except queue.Empty:\n                break\n            if kind == \'progress\':\n                latest = payload\n                continue\n            latest = None\n            self.busy = False\n            self.progress.hide()\n            self.stop.hide()\n            for control in self.controls:\n                control.setEnabled(True)\n            if self.list_content:\n                self.list_content.setEnabled(True)\n            if kind == \'error\':\n                self.render()\n                self.status.setText(payload)\n            else:\n                result, callback = payload\n                try:\n                    if callback:\n                        callback(result)\n                    else:\n                        self.render()\n                        self.status.setText(\'변경했습니다.\' if refresh_scripts() else \'메뉴 반영을 위해 FontLab을 재시작하세요.\')\n                except Exception as exc:\n                    self.status.setText(str(exc))\n            self.update_primary()\n        if latest is not None:\n            self.status.setText(latest)\n\n    def refresh(self):\n        def job():\n            changed = self.store.migrate_wrappers()\n            return self.store.catalog(manual=True), changed\n        def done(result):\n            catalog, changed = result\n            if changed:\n                refresh_scripts()\n            self.catalog_ready(catalog)\n        self.status.setText(\'목록을 확인하고 있습니다.\')\n        self.start(job, done)\n\n    def catalog_ready(self, result):\n        self.manifest, self.offline = result\n        self.errors.clear()\n        self.render()\n        self.status.setText(self.offline or \'\')\n        if self.bootstrap:\n            if not self.offline:\n                self.install_manager()\n            return\n        if not self.offline:\n            pending = [p for p in self.store.updates(self.manifest, automatic=True) if not compatibility(p)]\n            if pending:\n                self.install_many(pending)\n\n    def selected(self):\n        return [p for p in self.rows if p[\'id\'] in self.checked]\n\n    def choose(self, key, control):\n        checked = value(control, \'checked\')\n        control.setText(\'✓\' if checked else \'\')\n        if checked:\n            self.checked.add(key)\n        else:\n            self.checked.discard(key)\n        self.update_primary()\n\n    def update_primary(self):\n        selected = self.selected()\n        if not selected:\n            self.primary.setText(\'선택 설치\')\n        else:\n            state = self.store.read_state()\n            installed = sum(p[\'id\'] in state[\'packages\'] for p in selected)\n            action = \'업데이트\' if installed == len(selected) else (\'설치\' if not installed else \'설치 / 업데이트\')\n            self.primary.setText(\'선택한 %d개 %s\' % (len(selected), action))\n        self.primary.setEnabled(bool(selected) and not self.busy)\n\n    def render(self):\n        try:\n            state = self.store.read_state()\n        except ManagerError as exc:\n            self.status.setText(str(exc))\n            return\n        items = {p[\'id\']: p for p in (self.manifest or {}).get(\'scripts\', [])}\n        for key, record in state[\'packages\'].items():\n            items.setdefault(key, record[\'versions\'][record[\'active_version\']])\n        self.rows = []\n        content = QtGui.QWidget()\n        content.setObjectName(\'list\')\n        rows = QtGui.QVBoxLayout(content)\n        rows.setContentsMargins(0, 0, 6, 0)\n        rows.setSpacing(0)\n        selectable = set()\n        for p in items.values():\n            key = p[\'id\']\n            record = state[\'packages\'].get(key)\n            update = bool(record and is_newer_version(p[\'version\'], record[\'active_version\']))\n            if self.filter == \'installed\' and not record:\n                continue\n            if self.filter == \'updates\' and not update:\n                continue\n            self.rows.append(p)\n            reason = compatibility(p)\n            pinned = bool(record and record[\'pinned\'])\n            enabled = not reason and not pinned and (not record or update)\n            if enabled:\n                selectable.add(key)\n            status = \'업데이트 가능\' if update else (\'설치됨\' if record else \'미설치\')\n            if pinned:\n                status = \'버전 고정\'\n            if reason:\n                status = \'의존성 필요\' if reason.startswith(\'필요 라이브러리\') else \'호환 불가\'\n            if key in self.errors:\n                status = \'설치 실패\'\n            row = QtGui.QWidget()\n            row.setObjectName(\'row\')\n            row.setMinimumHeight(78)\n            line = QtGui.QHBoxLayout(row)\n            line.setContentsMargins(4, 16, 6, 16)\n            line.setSpacing(14)\n            pick = QtGui.QPushButton(\'✓\' if key in self.checked else \'\')\n            pick.setObjectName(\'pick\')\n            pick.setAutoDefault(False)\n            pick.setCheckable(True)\n            pick.setChecked(key in self.checked)\n            pick.setFixedSize(22, 22)\n            pick.setEnabled(enabled)\n            pick.setAccessibleName(p[\'name\'] + \' 설치 선택\')\n            pick.setToolTip(reason or (\'버전 고정을 해제하면 업데이트할 수 있습니다.\' if pinned else (\'설치할 새 버전이 없습니다.\' if record and not update else \'이번에 설치할 항목 선택\')))\n            pick.connect(\'clicked()\', lambda k=key, c=pick: self.choose(k, c))\n            line.addWidget(pick)\n            text = QtGui.QVBoxLayout()\n            text.setSpacing(5)\n            title = button(p[\'name\'], lambda k=key: self.details(k), \'name\')\n            title.setToolTip(\'상세 정보 및 설치 설정\')\n            text.addWidget(title)\n            version = \'v\' + (record[\'active_version\'] if record else p[\'version\'])\n            if update:\n                version += \'  →  v\' + p[\'version\']\n            text.addWidget(label(version, \'muted\'))\n            line.addLayout(text, 1)\n            state_label = label(status, \'rowStatus\')\n            state_label.setToolTip(self.errors.get(key) or reason or status)\n            line.addWidget(state_label)\n            more = button(\'›\', lambda k=key: self.details(k))\n            more.setAccessibleName(p[\'name\'] + \' 상세 정보\')\n            line.addWidget(more)\n            rows.addWidget(row)\n        self.checked.intersection_update(selectable)\n        if not self.rows:\n            empty = label(\'업데이트할 항목이 없습니다.\' if self.filter == \'updates\' else (\'설치된 스크립트가 없습니다.\' if self.filter == \'installed\' else \'목록을 불러오면 스크립트가 표시됩니다.\'), \'muted\')\n            empty.setContentsMargins(4, 32, 4, 32)\n            rows.addWidget(empty)\n        rows.addStretch()\n        old = self.scroll.takeWidget()\n        self.scroll.setWidget(content)\n        self.list_content = content\n        if old:\n            old.deleteLater()\n        content.setEnabled(not self.busy)\n        self.update_primary()\n\n    def detail_shell(self, title):\n        if self.detail_dialog:\n            self.detail_dialog.close()\n            self.detail_dialog.deleteLater()\n        dialog = QtGui.QDialog(self.dialog)\n        dialog.setWindowTitle(title)\n        dialog.setStyleSheet(STYLE)\n        dialog.setMinimumWidth(420)\n        layout = QtGui.QVBoxLayout(dialog)\n        layout.setContentsMargins(24, 24, 24, 24)\n        layout.setSpacing(16)\n        layout.addWidget(label(title, \'title\'))\n        self.detail_dialog = dialog\n        return dialog, layout\n\n    def close_detail(self):\n        if self.detail_dialog:\n            self.detail_dialog.close()\n\n    def details(self, key):\n        if self.busy:\n            return\n        p = next(p for p in self.rows if p[\'id\'] == key)\n        state = self.store.read_state()\n        record = state[\'packages\'].get(key)\n        dialog, layout = self.detail_shell(p[\'name\'])\n        description = label(p.get(\'description\', \'\'))\n        description.setWordWrap(True)\n        layout.addWidget(description)\n        layout.addWidget(label(\'배포 버전  \' + p[\'version\'] + (\'    설치 버전  \' + record[\'active_version\'] if record else \'\'), \'muted\'))\n        if p.get(\'requirements\'):\n            layout.addWidget(label(\'필요 라이브러리  \' + \', \'.join(p[\'requirements\']), \'muted\'))\n        message = self.errors.get(key) or compatibility(p)\n        if message:\n            warning = label(message)\n            warning.setWordWrap(True)\n            layout.addWidget(warning)\n        if p.get(\'changelog\'):\n            changelog = label(str(p[\'changelog\']))\n            changelog.setWordWrap(True)\n            layout.addWidget(changelog)\n        source = button(\'GitHub에서 소스 보기 ↗\', lambda: QtGui.QDesktopServices.openUrl(QtCore.QUrl(\'https://github.com/\' + REPOSITORY + \'/tree/\' + p[\'source_ref\'])))\n        layout.addWidget(source)\n        if record:\n            automatic = QtGui.QCheckBox(\'자동 업데이트\')\n            automatic.setChecked(record[\'auto_update\'])\n            pinned = QtGui.QCheckBox(\'현재 버전 유지\')\n            pinned.setChecked(record[\'pinned\'])\n            layout.addWidget(automatic)\n            layout.addWidget(pinned)\n            def save():\n                a, b = value(automatic, \'checked\'), value(pinned, \'checked\')\n                self.close_detail()\n                self.start(lambda: self.store.settings(key, a, b))\n            layout.addWidget(button(\'설정 저장\', save, \'primary\'))\n            actions = QtGui.QHBoxLayout()\n            rollback = button(\'이전 버전 복원\', lambda: self.rollback_selected(key))\n            rollback.setEnabled(bool(record.get(\'previous_version\')))\n            actions.addWidget(rollback)\n            actions.addStretch()\n            actions.addWidget(button(\'제거\', lambda: self.remove_selected(key, p[\'name\']), \'danger\'))\n            layout.addLayout(actions)\n        layout.addWidget(button(\'닫기\', dialog.close))\n        dialog.show()\n\n    def install_many(self, packages):\n        if not packages:\n            return\n        state = self.store.read_state()\n        ready = []\n        self.errors.clear()\n        for p in packages:\n            reason = compatibility(p)\n            record = state[\'packages\'].get(p[\'id\'])\n            if record and record[\'pinned\'] and record[\'active_version\'] != p[\'version\']:\n                reason = \'버전 고정을 먼저 해제하세요.\'\n            if reason:\n                self.errors[p[\'id\']] = reason\n            else:\n                ready.append(p)\n        def job():\n            errors = {}\n            for p in ready:\n                if self.cancel.is_set():\n                    raise Cancelled(\'작업을 취소했습니다\')\n                self.events.put((\'progress\', p[\'name\'] + \' 설치 중…\'))\n                try:\n                    self.store.install(p)\n                except Cancelled:\n                    raise\n                except Exception as exc:\n                    errors[p[\'id\']] = str(exc)\n            return errors\n        def done(errors):\n            self.errors.update(errors)\n            self.checked.difference_update(p[\'id\'] for p in ready if p[\'id\'] not in errors)\n            self.render()\n            refreshed = refresh_scripts()\n            self.status.setText(\'설치하지 못한 항목의 상세 정보를 확인하세요.\' if self.errors else\n                                (\'설치했습니다. Scripts 메뉴에서 실행할 수 있습니다.\' if refreshed else \'설치했습니다. 메뉴 반영을 위해 FontLab을 재시작하세요.\'))\n        self.status.setText(\'%d개 스크립트 설치를 준비합니다.\' % len(ready))\n        self.start(job, done)\n\n    def install_selected(self):\n        self.install_many(self.selected())\n\n    def remove_selected(self, key, name):\n        if QtGui.QMessageBox.question(self.detail_dialog, \'스크립트 제거\', name + \'을 제거할까요?\', QtGui.QMessageBox.Yes | QtGui.QMessageBox.No) == QtGui.QMessageBox.Yes:\n            self.close_detail()\n            self.start(lambda: self.store.remove(key))\n\n    def rollback_selected(self, key):\n        self.close_detail()\n        self.start(lambda: self.store.rollback(key))\n\n    def show_settings(self):\n        dialog, layout = self.detail_shell(\'매니저 설정\')\n        layout.addWidget(label(\'실행 버전  \' + RUNTIME_VERSION, \'muted\'))\n        layout.addWidget(button(\'매니저 업데이트 / 복구\', lambda: (self.close_detail(), self.install_manager())))\n        layout.addWidget(button(\'설치 상태 백업 복구\', self.recover))\n        layout.addWidget(button(\'닫기\', dialog.close))\n        dialog.show()\n\n    def install_manager(self):\n        if not self.manifest:\n            self.status.setText(\'먼저 온라인 목록을 확인하세요.\')\n            return\n        def done(result):\n            refreshed = refresh_scripts()\n            self.bootstrap = False\n            self.render()\n            self.status.setText(\'매니저를 설치했습니다.\' + (\'\' if refreshed else \' 메뉴 반영을 위해 FontLab을 재시작하세요.\') +\n                                (\' 새 버전은 FontLab 재시작 후 적용됩니다.\' if self.manifest[\'manager\'][\'version\'] != RUNTIME_VERSION else \'\'))\n        self.status.setText(\'매니저를 설치하고 있습니다.\')\n        self.start(lambda: self.store.install(self.manifest[\'manager\'], manager=True, repair=True), done)\n\n    def recover(self):\n        if QtGui.QMessageBox.question(self.detail_dialog, \'상태 복구\', \'직전 백업의 파일을 검증한 뒤 설치 상태를 복구할까요?\', QtGui.QMessageBox.Yes | QtGui.QMessageBox.No) == QtGui.QMessageBox.Yes:\n            self.close_detail()\n            self.start(self.store.recover)\n\n\ndef show_manager(env, bootstrap=False):\n    if _windows:\n        existing = _windows[0]\n        existing.dialog.show()\n        existing.dialog.raise_()\n        existing.dialog.activateWindow()\n        if bootstrap and not existing.busy:\n            existing.bootstrap = True\n            existing.refresh()\n        return existing\n    window = ManagerWindow(env, bootstrap)\n    _windows.append(window)\n    return window\n'}

def _mw_install():
    loaded = sys.modules.get("mwsm_core")
    if loaded is not None and getattr(loaded, "RUNTIME_VERSION", None) != "0.2.1":
        raise RuntimeError("FontLab을 재시작한 뒤 새 설치기를 다시 실행하세요.")
    # Never replace a live runtime: Qt widgets may still hold references to it.
    for name, source in _MW_SOURCES.items():
        if name not in sys.modules:
            module = types.ModuleType(name)
            module.__file__ = "<MW_install.vfpy>/" + name + ".py"
            sys.modules[name] = module
            try:
                exec(compile(source, module.__file__, "exec"), module.__dict__)
            except Exception:
                del sys.modules[name]
                raise
    from mwsm_host import environment
    from mwsm_ui import show_manager
    return show_manager(environment(), bootstrap=True)

try:
    _mw_install()
except Exception as exc:
    print("MW Script Manager installation failed:", exc)
    try:
        from PythonQt import QtGui
        QtGui.QMessageBox.warning(None, "MW Script Manager", str(exc))
    except ImportError:
        pass
    raise
